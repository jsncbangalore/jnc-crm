# =============================================================================
# Development Environment Configuration Example
# =============================================================================
# Copy this file to .env.development or .env for local development with local database.
# In development mode, DATABASE_URL MUST point to a local or development host (e.g. localhost).
# =============================================================================

NODE_ENV=development
PORT=3333

# Development Database (Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jnc_crm_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jnc_crm_dev?schema=public"

# Allowed Dev DB Hosts (optional comma-separated list extending local allowlist)
ALLOWED_DEV_DB_HOSTS="localhost,127.0.0.1,host.docker.internal"

# Authentication & Encryption Secrets (Development placeholders >= 32 characters)
JWT_SECRET="dev_jwt_secret_key_at_least_32_characters_long_for_security_12345"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_key_at_least_32_characters_long_12345"
OTP_SECRET="dev_otp_secret_key_at_least_32_characters_long_for_testing_12345"
ENCRYPTION_KEY="SobZRS8wQx0O7xSwOZwp8t1m7iFDKZ4XsAdNYM0b2gQ="

# Application URLs & CORS
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
TRUST_PROXY=0

# Development Mail Configuration (Mock / Local Sandbox)
EMAIL_FROM="dev-notifications@example.com"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER="dev_smtp_user"
SMTP_PASS="dev_smtp_password"
