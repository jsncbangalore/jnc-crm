PORT=3333
# Cloud Database Connection
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>"

# Cryptographic Token Secrets
JWT_SECRET="<YOUR_STRONG_256_BIT_JWT_SECRET>"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="<YOUR_STRONG_256_BIT_REFRESH_SECRET>"
JWT_REFRESH_EXPIRATION="7d"

REDIS_HOST="localhost"
REDIS_PORT=6379

# Primary Email Channel
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="<PRIMARY_SMTP_USER>"
SMTP_PASS="<PRIMARY_SMTP_PASSWORD>"
EMAIL_FROM="<PRIMARY_EMAIL_FROM>"
PRIMARY_EMAIL_FROM="<PRIMARY_EMAIL_FROM>"
FRONTEND_URL="https://admin.jsnc.co.in"

# Professional Invoice Email Channel
INVOICE_SMTP_HOST="smtp.gmail.com"
INVOICE_SMTP_PORT=465
INVOICE_SMTP_USER="<INVOICE_SMTP_USER>"
INVOICE_SMTP_PASS="<INVOICE_SMTP_PASSWORD>"
INVOICE_EMAIL_FROM="<INVOICE_EMAIL_FROM>"

# Webhook Secrets
WHATSAPP_APP_SECRET="<WHATSAPP_APP_SECRET>"
WHATSAPP_VERIFY_TOKEN="<WHATSAPP_VERIFY_TOKEN>"
INDIAMART_WEBHOOK_SECRET="<INDIAMART_WEBHOOK_SECRET>"
WEBSITE_WEBHOOK_SECRET="<WEBSITE_WEBHOOK_SECRET>"

# Database Backup & Encryption at Rest
ENCRYPTION_KEY="<32_BYTES_BASE64_ENCRYPTION_KEY>"
BACKUP_ENCRYPTION_KEY="<AES_256_BACKUP_ENCRYPTION_KEY>"
BACKUP_OFFSITE_PATH="backups/offsite"
