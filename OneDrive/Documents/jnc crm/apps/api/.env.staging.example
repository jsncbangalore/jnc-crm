# JNC-CRM API Staging Environment Configuration Template
# Names only - do NOT commit real credentials or secret values

PORT=3333
NODE_ENV=production

# Database Connection (Staging host must be listed in ALLOWED_DB_HOSTS; live Supabase is strictly forbidden)
DATABASE_URL=
ALLOWED_DB_HOSTS=

# Cryptographic Authentication & Encryption Keys (Generate via crypto.randomBytes)
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# Frontend Application & CORS Configuration
FRONTEND_URL=
CORS_ORIGIN=
CORS_ORIGINS=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
