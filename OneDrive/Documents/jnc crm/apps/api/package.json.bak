    "@types/nodemailer": "^6.4.14",
    "@types/papaparse": "^5.3.14",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.10.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}

