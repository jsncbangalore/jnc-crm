  "private": true,
  "scripts": {
    "build": "node ../../node_modules/@nestjs/cli/bin/nest.js build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node ../../node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node ../../node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "node ../../node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ../../node_modules/prisma/build/index.js migrate dev",
    "prisma:db-push": "node ../../node_modules/prisma/build/index.js db push",
    "prisma:seed": "node ../../node_modules/ts-node/dist/bin.js prisma/seed.ts",
    "db:push:dev": "node scripts/prisma-safe.js db-push-dev",
    "db:push:test": "node scripts/prisma-safe.js db-push-test",
    "db:seed:test": "node scripts/prisma-safe.js seed-test",
    "db:setup:dev": "node scripts/prisma-safe.js setup-dev",
    "contacts:report": "node ../../node_modules/ts-node/dist/bin.js scripts/report-orphan-contacts.ts",
    "test:phase3": "node scripts/prisma-safe.js test-phase3",
    "test:visibility": "node scripts/prisma-safe.js test-visibility",
    "test:login": "node scripts/prisma-safe.js test-login",
    "test:security": "node scripts/prisma-safe.js test-security",
    "migrate:prod": "node scripts/prisma-safe.js migrate-prod",
    "owner:reset": "node scripts/prisma-safe.js owner:reset"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.3",
    "@nestjs/core": "^10.3.3",
