// Prisma Schema for JNC-CRM Multi-Tenant SaaS Platform
// Multi-Tenant SaaS Platform Partitioning

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. TENANT (COMPANY WORKSPACE ENTITY)
// ==========================================
model Tenant {
  id              String         @id @default(uuid())
  code            String         @unique // e.g. "JNC-ORG-001", "ACME", "VERTEX"
  name            String         // Display Company Name
  slug            String         @unique // Subdomain/URL identifier
  status          String         @default("active") // active | suspended | expired
  planTier        String         @default("standard") // starter | professional | enterprise
  maxUsers        Int            @default(10)

  // Isolated Company Branding & Configuration
  logoUrl             String?
  phone               String?
  email               String?
  address             String?
  city                String?
  state               String?        @default("Karnataka")
  pincode             String?
  website             String?
  gstin               String?
  pan                 String?
  currency            String         @default("INR")
  lutBondNo           String?        @default("AD290525013648T")
  lutValidity         String?        @default("From : 10/05/2025 To: 09/05/2026")
  invoicePrefix       String?        @default("INV")
  invoiceTerms        String?

  // Banking Details for Invoices
  bankName            String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankBranch          String?
  bankUpi             String?

  // Signatory & Stamp
  signatoryName       String?
  signatoryDesignation String?
  signatureUrl        String?
  stampUrl            String?

  isOnboarded         Boolean        @default(false)
  isInternal          Boolean        @default(false)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  // Relations
  users           User[]
  companies       Company[]      // B2B Accounts registered within this tenant
  contacts        Contact[]
  leads           Lead[]
  leadShares      LeadShare[]
  mailAccounts    MailAccount[]  // Per-tenant isolated SMTP configurations
  suppliers       Supplier[]
  products        Product[]
  skus            Sku[]
  warehouses      Warehouse[]
  quotations      Quotation[]
  orders          Order[]
  shipments       Shipment[]
  invoices        Invoice[]
  stockTransfers  StockTransfer[]
  customObjects   CustomObject[]
  customRecords   CustomObjectRecord[]
  teams           Team[]
  projects        Project[]
  automationRules AutomationRule[]
  messageLogs     MessageLog[]
  auditLogs       AuditLog[]
  paymentRecords  PaymentRecord[]
  stockPositions  ProjectStockPosition[]

  @@index([status])
}

// ==========================================
// 2. USER & AUTH
// ==========================================
model User {
  id                  String          @id @default(uuid())
  tenantId            String?         // Nullable only for Platform Super Admin
  employeeCode        String
  name                String
  email               String
  passwordHash        String
  role                String          @default("employee") // platform_super_admin | tenant_admin | admin | sub_admin | employee | store_manager | project_manager | developer_lead | developer
  teamId              String?
  team                String?
  warehouseId         String?
  phone               String?
  isActive            Boolean         @default(true)
  mustResetPassword   Boolean         @default(false)
  lastLoginAt         DateTime?
  failedLoginAttempts Int             @default(0)
  lockoutUntil        DateTime?
  tokenVersion        Int             @default(0)
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  tenant              Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamRef             Team?           @relation("UserTeam", fields: [teamId], references: [id])
  createdBy           User?           @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers        User[]          @relation("CreatedUsers")
  assignedLeads       Lead[]          @relation("AssignedLeads")
  sharedLeads         LeadShare[]     @relation("SharedLeads")
  leadActivities      LeadActivity[]  @relation("PerformedActivities")
  createdQuotes       Quotation[]     @relation("CreatedQuotes")
  createdOrders       Order[]         @relation("CreatedOrders")
  createdInvoices     Invoice[]       @relation("CreatedInvoices")
  stockMovements      StockMovement[] @relation("UserStockMovements")
  initiatedTransfers  StockTransfer[] @relation("InitiatedTransfers")
  receivedTransfers   StockTransfer[] @relation("ReceivedTransfers")
  createdCustomObjects CustomObject[] @relation("CreatedCustomObjects")
  createdCustomRecords CustomObjectRecord[] @relation("CreatedCustomRecords")
  updatedCustomRecords CustomObjectRecord[] @relation("UpdatedCustomRecords")
  auditLogs           AuditLog[]      @relation("UserAuditLogs")
  recordedPayments    PaymentRecord[] @relation("RecordedPayments")
  createdProjects     Project[]       @relation("CreatedProjects")
  uploadedProjectLogs ProjectDailyLog[] @relation("UploadedProjectLogs")
  projectAssignments  ProjectAssignment[] @relation("AssignedProjectUser")
  createdProjectAssignments ProjectAssignment[] @relation("AssignedByProjectUser")
  createdCompanies  Company[]  @relation("CreatedCompanies")
  createdContacts   Contact[]  @relation("CreatedContacts")
  createdLeads      Lead[]     @relation("CreatedLeads")
  createdSuppliers  Supplier[] @relation("CreatedSuppliers")
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsedSelectionToken {
  jti       String   @id
  usedAt    DateTime @default(now())
}

// ==========================================
// 3. CRM CORE ENTITIES (SCOPED BY TENANT)
// ==========================================
model Company {
  id           String    @id @default(uuid())
  tenantId     String    @default("default-tenant-id")
  name         String
  gstin        String?
  industry     String?
  address      String?
  city         String?
  state        String?   @default("Karnataka")
  website      String?
  billingEmail String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User?     @relation("CreatedCompanies", fields: [createdById], references: [id])
  contacts     Contact[]
  leads        Lead[]
  invoices     Invoice[]

  @@index([tenantId])
}

model Contact {
  id          String    @id @default(uuid())
  tenantId    String?
  companyId   String?
  name        String
  email       String?
  phone       String
  designation String?
  isPrimary   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("CreatedContacts", fields: [createdById], references: [id])
  leads       Lead[]
  quotations  Quotation[]
  orders      Order[]

  @@index([tenantId])
}

model Lead {
  id              String      @id @default(uuid())
  tenantId        String      @default("default-tenant-id")
  leadNumber      String
  source          String      @default("manual") // indiamart | web | whatsapp | manual
  status          String      @default("new")    // new | contacted | qualified | quoted | won | lost
  companyId       String?
  contactId       String?
  assignedToId    String?
  
  customerName    String
  customerPhone   String
  customerEmail   String?
  city            String?
  productCategory String?
  productName     String?
  quantity        Int?
  estimatedValue  Float?      @default(0)
  urgency         String?     @default("standard")
  queryMessage    String?
  rawPayload      String?
  isDuplicate     Boolean     @default(false)
  createdById     String?
  lostReason      String?
  
  capturedAt      DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company?       @relation(fields: [companyId], references: [id])
  contact         Contact?       @relation(fields: [contactId], references: [id])
  assignedTo      User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  createdBy       User?          @relation("CreatedLeads", fields: [createdById], references: [id])
  activities      LeadActivity[]
  quotations      Quotation[]
  shares          LeadShare[]

  @@unique([tenantId, leadNumber])
  @@index([tenantId])
  @@index([status])
}

model LeadShare {
  id          String   @id @default(uuid())
  tenantId    String   @default("default-tenant-id")
  leadId      String
  userId      String
  sharedById  String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User     @relation("SharedLeads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leadId, userId])
  @@index([tenantId])
}

// ==========================================
// 4. PER-TENANT ISOLATED MAIL ACCOUNTS
// ==========================================
model MailAccount {
  id           String   @id @default(uuid())
  tenantId     String   @default("default-tenant-id")
  name         String   // e.g. "Acme Sales Mail"
  email        String
  senderName   String?
  smtpHost     String
  smtpPort     Int      @default(587)
  smtpUser     String
  smtpPass     String   // Encrypted at rest
  isSecure     Boolean  @default(false)
  purpose      String   @default("PRIMARY_ALERTS") // PRIMARY_ALERTS | BILLING_INVOICES | SALES_OUTBOUND
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, purpose])
}

model LeadActivity {
  id          String    @id @default(uuid())
  leadId      String
  userId      String?
  type        String    // call | email | note | meeting | reminder | task
  title       String
  description String?
  scheduledAt DateTime?
  completedAt DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User?     @relation("PerformedActivities", fields: [userId], references: [id])
}

// ==========================================
// 5. INVENTORY, PRODUCTS & WAREHOUSES (PER-TENANT)
// ==========================================
model Supplier {
  id            String    @id @default(uuid())
  tenantId      String    @default("default-tenant-id")
  name          String
  contactPerson String?
  email         String?
  phone         String?
  gstin         String?
  address       String?
  city          String?
  leadTimeDays  Int       @default(7)
  rating        Float?    @default(4.5)
  notes         String?
  isActive      Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User?           @relation("CreatedSuppliers", fields: [createdById], references: [id])
  preferredSkus Sku[]           @relation("PreferredSupplier")
  stockMovements StockMovement[] @relation("SupplierMovements")

  @@index([tenantId])
}

model Product {
  id          String    @id @default(uuid())
  tenantId    String    @default("default-tenant-id")
  name        String
  category    String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  skus        Sku[]

  @@index([tenantId])
}

model Sku {
  id                  String    @id @default(uuid())
  tenantId            String    @default("default-tenant-id")
  productId           String?
  skuCode             String
  name                String
  category            String
  hsnCode             String?
  packageType         String?
  unitPrice           Float
  costPrice           Float
  taxRate             Float     @default(18.0)
  reorderPoint        Int       @default(100)
  reorderQty          Int       @default(500)
  datasheetUrl        String?
  preferredSupplierId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product             Product?        @relation(fields: [productId], references: [id])
  preferredSupplier   Supplier?       @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  stockItems          StockItem[]
  stockMovements      StockMovement[]
  quotationLines      QuotationLine[]
  orderLines          OrderLine[]
  invoiceLines        InvoiceLine[]
  transfers           StockTransfer[]

  @@unique([tenantId, skuCode])
  @@index([tenantId])
}

model Warehouse {
  id          String    @id @default(uuid())
  tenantId    String    @default("default-tenant-id")
  code        String
  name        String
  address     String?
  city        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bins              LocationBin[]
  stockItems        StockItem[]
  sourceMovements   StockMovement[] @relation("SourceWarehouse")
  destMovements     StockMovement[] @relation("DestWarehouse")
  outgoingTransfers StockTransfer[] @relation("SourceTransfers")
  incomingTransfers StockTransfer[] @relation("DestTransfers")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model LocationBin {
  id          String    @id @default(uuid())
  warehouseId String
  binCode     String
  zone        String
  rack        String
  shelf       String
  createdAt   DateTime  @default(now())

  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItems  StockItem[]

  @@unique([warehouseId, binCode])
}

model StockItem {
  id               String    @id @default(uuid())
  skuId            String
  warehouseId      String
  binId            String?
  quantityOnHand   Int       @default(0)
  quantityReserved Int       @default(0)
  batchNo          String?
  mfgDate          DateTime?
  expiryDate       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sku              Sku          @relation(fields: [skuId], references: [id])
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id])
  bin              LocationBin? @relation(fields: [binId], references: [id])

  @@unique([skuId, warehouseId, binId, batchNo])
}

model StockMovement {
  id                String    @id @default(uuid())
  skuId             String
  type              String    // inward | outward | transfer | adjustment
  quantity          Int
  supplierId        String?
  sourceWarehouseId String?
  destWarehouseId   String?
  batchNo           String?
  reasonCode        String?
  referenceType     String?
  referenceId       String?
  documentUrl       String?
  performedById     String?
  createdAt         DateTime  @default(now())

  sku               Sku        @relation(fields: [skuId], references: [id])
  supplier          Supplier?  @relation("SupplierMovements", fields: [supplierId], references: [id])
  sourceWarehouse   Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse     Warehouse? @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  performedBy       User?      @relation("UserStockMovements", fields: [performedById], references: [id])
}

model ProjectStockPosition {
  id                 String    @id @default(uuid())
  tenantId           String    @default("default-tenant-id")
  project            String
  reference          String
  quantity           Float     @default(1)
  itemCode           String
  partValue          String?
  package            String?
  unit               String    @default("Nos")
  bomQtyPerUnit      Float     @default(1)
  batchQty           Float     @default(1)
  plannedRequirement Float     @default(1)
  openingStock       Float     @default(0)
  inflow             Float     @default(0)
  outflow            Float     @default(0)
  presentStock       Float     @default(0)
  shortage           Float     @default(0)
  status             String    @default("Sufficient")
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([project])
  @@index([itemCode])
}

// ==========================================
// 6. QUOTATIONS, ORDERS & INVOICES (PER-TENANT)
// ==========================================
model Quotation {
  id            String    @id @default(uuid())
  tenantId      String    @default("default-tenant-id")
  quoteNumber   String
  leadId        String?
  contactId     String?
  createdById   String?
  status        String    @default("draft") // draft | sent | approved | rejected
  subtotal      Float     @default(0)
  taxRate       Float     @default(18.0)
  taxAmount     Float     @default(0)
  totalAmount   Float     @default(0)
  validUntil    DateTime
  notes         String?
  terms         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          Lead?           @relation(fields: [leadId], references: [id])
  contact       Contact?        @relation(fields: [contactId], references: [id])
  createdBy     User?           @relation("CreatedQuotes", fields: [createdById], references: [id])
  lines         QuotationLine[]
  order         Order?

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
}

model QuotationLine {
  id          String    @id @default(uuid())
  quotationId String
  skuId       String
  quantity    Int
  unitPrice   Float
  discount    Float     @default(0)
  totalPrice  Float
  notes       String?

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sku         Sku       @relation(fields: [skuId], references: [id])
}

model Order {
  id              String    @id @default(uuid())
  tenantId        String    @default("default-tenant-id")
  orderNumber     String
  quotationId     String?   @unique
  contactId       String?
  createdById     String?
  status          String    @default("confirmed")
  paymentStatus   String    @default("pending")
  advancePercent  Float?    @default(50.0)
  advanceAmount   Float?    @default(0)
  paidAmount      Float     @default(0)
  balanceAmount   Float     @default(0)
  paymentRef      String?
  subtotal        Float     @default(0)
  taxAmount       Float     @default(0)
  totalAmount     Float     @default(0)
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String?
  notes           String?
  confirmedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation       Quotation?    @relation(fields: [quotationId], references: [id])
  contact         Contact?      @relation(fields: [contactId], references: [id])
  createdBy       User?         @relation("CreatedOrders", fields: [createdById], references: [id])
  lines           OrderLine[]
  shipments       Shipment[]
  invoices        Invoice[]
  payments        PaymentRecord[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
}

model OrderLine {
  id          String    @id @default(uuid())
  orderId     String
  skuId       String
  quantity    Int
  unitPrice   Float
  taxRate     Float     @default(18.0)
  totalPrice  Float

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         Sku       @relation(fields: [skuId], references: [id])
}

model Shipment {
  id              String    @id @default(uuid())
  tenantId        String    @default("default-tenant-id")
  shipmentNumber  String
  orderId         String
  courierName     String
  trackingNumber  String
  trackingUrl     String?
  status          String    @default("dispatched")
  notes           String?
  dispatchedAt    DateTime  @default(now())
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shipmentNumber])
  @@index([tenantId])
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String        @default("default-tenant-id")
  invoiceNumber   String
  docType         String        @default("tax_invoice")
  orderId         String?
  companyId       String?
  createdById     String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  customerName    String
  customerPhone   String
  customerEmail   String?
  customerGstin   String?
  customerState   String        @default("Karnataka")
  billingAddress  String?
  deliveryAddress String?
  referenceNo     String?
  buyerOrderNo    String?
  poDate          DateTime?
  lutBondNo       String?       @default("AD290525013648T")
  lutValidity     String?       @default("From : 10/05/2025 To: 09/05/2026")
  isSez           Boolean       @default(false)
  advancePercent  Float?
  advanceAmount   Float?
  advanceAdjusted Float?        @default(0)
  balanceDue      Float?        @default(0)
  paymentMethod   String?
  transactionRef  String?
  subtotal        Float         @default(0)
  cgstAmount      Float         @default(0)
  sgstAmount      Float         @default(0)
  igstAmount      Float         @default(0)
  totalAmount     Float         @default(0)
  paymentTerms    String?       @default("Advance")
  paymentStatus   String        @default("unpaid")
  pdfUrl          String?
  isVoided        Boolean       @default(false)
  voidedAt        DateTime?
  voidReason      String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order?        @relation(fields: [orderId], references: [id])
  company         Company?      @relation(fields: [companyId], references: [id])
  createdBy       User?         @relation("CreatedInvoices", fields: [createdById], references: [id])
  lines           InvoiceLine[]
  payments        PaymentRecord[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
}

model InvoiceLine {
  id          String    @id @default(uuid())
  invoiceId   String
  skuId       String?
  hsnCode     String?
  description String
  unit        String    @default("No's")
  quantity    Int
  unitPrice   Float
  taxRate     Float     @default(18.0)
  cgstRate    Float     @default(0)
  cgstAmount  Float     @default(0)
  sgstRate    Float     @default(0)
  sgstAmount  Float     @default(0)
  igstRate    Float     @default(0)
  igstAmount  Float     @default(0)
  lineTotal   Float

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku         Sku?      @relation(fields: [skuId], references: [id])
}

model StockTransfer {
  id                     String    @id @default(uuid())
  tenantId               String    @default("default-tenant-id")
  transferNumber         String
  skuId                  String
  sourceWarehouseId      String
  destinationWarehouseId String
  quantity               Int
  status                 String    @default("in_transit")
  notes                  String?
  initiatedById          String?
  initiatedAt            DateTime  @default(now())
  receivedById           String?
  receivedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku                    Sku       @relation(fields: [skuId], references: [id])
  sourceWarehouse        Warehouse @relation("SourceTransfers", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse @relation("DestTransfers", fields: [destinationWarehouseId], references: [id])
  initiatedBy            User?     @relation("InitiatedTransfers", fields: [initiatedById], references: [id])
  receivedBy             User?     @relation("ReceivedTransfers", fields: [receivedById], references: [id])

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
}

// ==========================================
// 7. CUSTOM OBJECTS (PER-TENANT DATA EXTENSION)
// ==========================================
model CustomObject {
  id          String        @id @default(uuid())
  tenantId    String        @default("default-tenant-id")
  apiName     String
  label       String
  pluralLabel String
  description String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("CreatedCustomObjects", fields: [createdById], references: [id])
  fields      CustomField[]
  records     CustomObjectRecord[]

  @@unique([tenantId, apiName])
  @@index([tenantId])
}

model CustomField {
  id                 String       @id @default(uuid())
  objectId           String
  apiName            String
  label              String
  fieldType          String
  isRequired         Boolean      @default(false)
  isUnique           Boolean      @default(false)
  picklistValues     String?
  lookupTargetObject String?
  displayOrder       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  object             CustomObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, apiName])
}

model CustomObjectRecord {
  id          String        @id @default(uuid())
  tenantId    String        @default("default-tenant-id")
  objectId    String
  data        String
  createdById String?
  updatedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  object      CustomObject  @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("CreatedCustomRecords", fields: [createdById], references: [id])
  updatedBy   User?         @relation("UpdatedCustomRecords", fields: [updatedById], references: [id])

  @@index([tenantId])
  @@index([objectId])
}

// ==========================================
// 8. TEAMS, ACTIVITIES & AUTOMATION (PER-TENANT)
// ==========================================
model Team {
  id           String   @id @default(uuid())
  tenantId     String   @default("default-tenant-id")
  name         String
  allowedPages String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users        User[]   @relation("UserTeam")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Project {
  id          String            @id @default(uuid())
  tenantId    String            @default("default-tenant-id")
  name        String
  description String?
  status      String            @default("active")
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?             @relation("CreatedProjects", fields: [createdById], references: [id])
  dailyLogs   ProjectDailyLog[]
  assignments ProjectAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ProjectDailyLog {
  id           String   @id @default(uuid())
  projectId    String
  logDate      DateTime @default(now())
  uploadedById String?
  fileName     String?
  taskSummary  String?
  recordsJson  String
  rawPayload   String?
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation("UploadedProjectLogs", fields: [uploadedById], references: [id])

  @@index([projectId])
}

model ProjectAssignment {
  id           String   @id @default(uuid())
  projectId    String
  userId       String
  roleInProject String?
  assignedById String?
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User     @relation("AssignedProjectUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?    @relation("AssignedByProjectUser", fields: [assignedById], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model AutomationRule {
  id                String           @id @default(uuid())
  tenantId          String           @default("default-tenant-id")
  name              String
  triggerEvent      String
  conditionJson     String           @default("{}")
  actionType        String?
  actionPayloadJson String?          @default("{}")
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps             AutomationStep[]

  @@index([tenantId])
}

model AutomationStep {
  id         String         @id @default(uuid())
  ruleId     String
  stepOrder  Int            @default(1)
  stepType   String
  config     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model DelayedAutomationJob {
  id           String    @id @default(uuid())
  ruleId       String
  stepIndex    Int
  entityType   String
  entityId     String
  contextJson  String
  executeAt    DateTime
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([status, executeAt])
}

model MessageLog {
  id                String    @id @default(uuid())
  tenantId          String    @default("default-tenant-id")
  channel           String
  recipient         String
  subject           String?
  body              String
  status            String    @default("sent")
  errorMessage      String?
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime  @default(now())

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id          String    @id @default(uuid())
  tenantId    String    @default("default-tenant-id")
  actorId     String?
  actorName   String?
  action      String
  entityName  String
  entityId    String
  beforeState String?
  afterState  String?
  ipAddress   String?
  timestamp   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?     @relation("UserAuditLogs", fields: [actorId], references: [id])

  @@index([tenantId])
}

model PaymentRecord {
  id              String    @id @default(uuid())
  tenantId        String    @default("default-tenant-id")
  orderId         String?
  invoiceId       String?
  amount          Float
  paymentType     String    @default("advance")
  paymentMethod   String    @default("NEFT")
  transactionRef  String?
  paymentDate     DateTime  @default(now())
  notes           String?
  recordedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy      User?     @relation("RecordedPayments", fields: [recordedById], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([invoiceId])
}

model StatusHistory {
  id          String    @id @default(uuid())
  entityType  String
  entityId    String
  fromStatus  String?
  toStatus    String
  changedById String?
  note        String?
  changedAt   DateTime  @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AccountLockout {
  id             String    @id @default(uuid())
  identityKey    String    @unique
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
