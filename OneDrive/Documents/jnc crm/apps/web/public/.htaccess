# CRM Single Page Application (SPA) Apache Rewrite Configuration

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Enable UTF-8 encoding
  AddDefaultCharset UTF-8

  # 2. Prevent directory listing (commented out for shared hosting compatibility)
  # Options -Indexes

  # 3. Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Fallback all non-file routes to index.html for React Router pushState
  RewriteRule ^ index.html [L]
</IfModule>

# Ensure correct MIME Types for modern web assets (ES modules, CSS, SVGs, Fonts)
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Security Headers (Clickjacking, MIME sniffing, HSTS, CSP, Permissions)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self' *;"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # index.html: no-cache, must-revalidate (never cache private SPA shell)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Hashed JS and CSS assets may stay cached
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico|webp)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
