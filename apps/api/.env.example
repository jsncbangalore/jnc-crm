PORT=3333
NODE_ENV=production

# White-Label Product Branding
PRODUCT_NAME="CRM"
PRODUCT_LOGO_URL=""

# Database Connection (PostgreSQL with SSL)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"
DIRECT_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>"

# Security & CORS Origins (Required in production)
FRONTEND_URL="https://<YOUR_FRONTEND_DOMAIN>"
ALLOWED_ORIGINS="https://<YOUR_FRONTEND_DOMAIN>,https://<YOUR_ADMIN_SUBDOMAIN>"

# Cryptographic Token & Encryption Secrets (Min 32 characters each)
JWT_SECRET="<YOUR_STRONG_32_CHAR_JWT_SECRET>"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="<YOUR_STRONG_32_CHAR_REFRESH_SECRET>"
JWT_REFRESH_EXPIRATION="7d"
OTP_SECRET="<YOUR_STRONG_32_CHAR_OTP_SECRET>"
ENCRYPTION_KEY="<YOUR_STRONG_32_CHAR_ENCRYPTION_KEY>"

# System Email Sender & SMTP Transport (Required in production: EMAIL_FROM must equal SMTP_USER)
SMTP_HOST="<YOUR_SMTP_HOST>"
SMTP_PORT=465
SMTP_USER="<YOUR_SYSTEM_EMAIL_ADDRESS>"
SMTP_PASS="<YOUR_SMTP_PASSWORD>"
SMTP_SECURE=true
EMAIL_FROM="<YOUR_SYSTEM_EMAIL_ADDRESS>"

# Initial Owner Provisioning (Used by seed-owner-only)
OWNER_EMAIL="<OWNER_EMAIL>"
OWNER_NAME="<OWNER_NAME>"
OWNER_PHONE="<OWNER_PHONE>"
OWNER_PASSWORD="<OWNER_PASSWORD>"

# Webhook Secrets
WHATSAPP_APP_SECRET="<WHATSAPP_APP_SECRET>"
WHATSAPP_VERIFY_TOKEN="<WHATSAPP_VERIFY_TOKEN>"
INDIAMART_WEBHOOK_SECRET="<INDIAMART_WEBHOOK_SECRET>"
WEBSITE_WEBHOOK_SECRET="<WEBSITE_WEBHOOK_SECRET>"
