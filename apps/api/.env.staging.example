# CRM API Staging Environment Configuration Template
# Placeholders only - do NOT commit real credentials or secret values

PORT=3333
NODE_ENV=staging

# Product Branding
PRODUCT_NAME="CRM"
PRODUCT_LOGO_URL=""

# Database Connection (Staging host must be listed in ALLOWED_DB_HOSTS)
