JWT_REFRESH_SECRET=
OTP_SECRET=
ENCRYPTION_KEY=

# Frontend Application & CORS Configuration
FRONTEND_URL=
ALLOWED_ORIGINS=

# SMTP Email Configuration (EMAIL_FROM must match SMTP_USER)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_FROM=
