{
  "name": "crm-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "scan:branding": "node scripts/scan-branding.js",
    "test:white-label": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-white-label.ts",
    "start:api": "npm --workspace=apps/api run start:dev",
    "start:web": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/api run build && npm --workspace=apps/web run build",
    "seed": "npm --workspace=apps/api run prisma:seed",
    "postinstall": "npm --workspace=apps/api run prisma:generate",
    "env:check": "npm --workspace=apps/api run env:check",
    "bundle:api": "node scripts/bundle-api.js",
    "bundle:test-linux": "node scripts/bundle-test-linux.js",
    "release:pack": "node scripts/release-pack.js",
    "release:verify": "node scripts/release-verify.js",
    "test:all": "node scripts/test-all-runner.js",
    "test:contract-dtos": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-contract-dto-keys.ts",
    "balance-impact": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/balance-impact-analysis.ts",
    "test:print-csp": "node scripts/test-print-csp-suite.js",
    "verify:live": "node scripts/verify-live.js",
    "db:dev:up": "node scripts/db-dev.js up",
    "db:dev:migrate": "node scripts/db-dev.js migrate",
    "db:dev:seed": "node scripts/db-dev.js seed",
    "db:dev:reset": "node scripts/db-dev.js reset",
    "docs:recent": "node scripts/count-recent-docs.js",
    "db:preflight-live": "node scripts/db-preflight-live.js",
    "db:predeploy-guard": "node scripts/render-predeploy-guard.js",
    "bootstrap:live": "node scripts/bootstrap-live.js",
    "db:backup": "node scripts/db-backup.js",
    "dev:live": "node scripts/dev-live.js",
    "live:status": "node scripts/live-status.js",
    "live:reset-account": "node scripts/live-reset-account.js",
    "live:rls-check": "node scripts/live-rls-check.js",
    "staging:migrate": "node scripts/staging-cmd.js migrate staging",
    "staging:status": "node scripts/staging-cmd.js status staging",
    "check:prisma-fields": "node scripts/check-prisma-fields.js",
    "mail:test": "node scripts/mail-test.js",
    "backend:push": "node scripts/push-backend.js",
    "admin:set-password": "npm --workspace=apps/api run admin:set-password",
    "admin:reset-2fa": "npm --workspace=apps/api run admin:reset-2fa",
    "admin:extend-2fa-grace": "npm --workspace=apps/api run admin:extend-2fa-grace --",
    "admin:2fa-status": "npm --workspace=apps/api run admin:2fa-status --",
    "admin:set-phone": "npm --workspace=apps/api run admin:set-phone",
    "test:auth-security": "npm --workspace=apps/api run test:auth-security",
    "test:page-registry": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-page-registry.ts",
    "test:access-control": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-page-access-control.ts",
    "test:navigation-audit": "node scripts/test-navigation-routes-audit.js",
    "test:branding-logo": "node scripts/test-branding-logo-limits.js",
    "test:permissions-e2e": "node scripts/test-page-permissions-e2e.js",
    "test:migration-parity": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-prisma-migrations-parity.ts",
    "test:payments-unification": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-payments-unification.ts",
    "test:chain-e2e": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-chain-e2e.ts",
    "test:e2e-playwright": "node scripts/test-playwright-e2e.js",
    "test:landing": "node scripts/test-landing-page.js",
    "build:marketing": "node scripts/build-marketing-site.js",
    "verify:seo": "node scripts/verify-seo-site.js",
    "migration:preflight": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/migration-preflight.ts",
    "test:session:inactivity": "node scripts/test-inactivity-fake-timers.js",
    "test:session:grace": "node scripts/test-refresh-rotation-grace.js",
    "test:session:cookies": "node scripts/test-cookie-flags-prod.js",
    "test:session:replay": "node scripts/test-replay-safety.js",
    "test:session:suite": "npm run test:session:inactivity && npm run test:session:grace && npm run test:session:cookies && npm run test:session:replay",
    "historical:dry": "node node_modules/ts-node/dist/bin.js scripts/historical_advance_correction.ts",
    "historical:apply": "node node_modules/ts-node/dist/bin.js scripts/historical_advance_correction.ts --apply --confirm",
    "test:reconcile": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-reconciliation.ts",
    "test:meta-webhook": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-meta-webhook-suite.ts",
    "test:ledger-integrity": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-party-ledger-integrity.ts",
    "test:banned-words": "node scripts/test-banned-words.js",
    "test:dto-contracts": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-dto-contract-mismatches.ts",
    "test:text-audit": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-text-audit.ts",
    "test:form-errors": "node scripts/test-form-error-handling-playwright.js",
    "host:env": "node scripts/host-env.js",
    "test:subtitles": "node scripts/test-page-subtitles.js",
    "test:tenant-isolation": "node --env-file=.env.development node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-cross-tenant-isolation.ts",
    "test:idempotency-parallel": "node --env-file=.env.development node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json scripts/test-payment-idempotency-parallel.ts",
    "lint:hooks": "node node_modules/eslint/bin/eslint.js \"apps/web/src/**/*.{ts,tsx}\"",
    "test:modal-hooks": "node scripts/test-hooks-modal-cycles.js",
    "test:vitest": "node ./node_modules/vitest/vitest.mjs run",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35",
    "adm-zip": "^0.6.1",
    "pdf-parse": "^2.4.5",
    "playwright": "1.63.0",
    "playwright-core": "^1.62.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
